# Do Medo ao Play: regras para hospedagem Apache/LiteSpeed (Hostinger).
# Vai na raiz do site (public_html) com o nome .htaccess.

# Endereço sempre em https, em um redirecionamento só.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Para escolher entre www e sem www, descomente UM dos pares abaixo
  # (troque dominio.com.br pelo domínio real):
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Tipos de arquivo (alguns servidores ainda não conhecem AVIF e WOFF2).
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
</IfModule>

# Compressão do texto (HTML, CSS, JS, SVG). Imagens, vídeo e fontes já vêm comprimidos.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json text/plain
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript text/javascript image/svg+xml application/json text/plain
</IfModule>

# Cache no navegador.
# CSS, JS e fontes: 1 ano. Seguro porque todo CSS/JS é chamado com ?v=... no
# HTML (suba o número quando o arquivo mudar) e as fontes têm a versão no nome.
# Imagens e vídeos: 1 dia. HTML: sempre confere se há versão nova.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg|mp4|ico)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Sem listar o conteúdo das pastas.
Options -Indexes
